{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nycpayroll-35985"
		},
		"LS_ADLS_NYC_PAYROLL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_NYC_PAYROLL'"
		},
		"LS_AZURE_SQL_NYC_PAYROLL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZURE_SQL_NYC_PAYROLL'"
		},
		"LS_ADLS_NYC_PAYROLL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stnycpayroll72665.dfs.core.windows.net/"
		},
		"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nycpayroll-88164.database.windows.net"
		},
		"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_nycpayroll"
		},
		"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladminuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-nycpayroll-35985_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_NYC_PAYROLL_accountKey": {
						"value": "[parameters('LS_ADLS_NYC_PAYROLL_accountKey')]"
					},
					"LS_AZURE_SQL_NYC_PAYROLL_password": {
						"value": "[parameters('LS_AZURE_SQL_NYC_PAYROLL_password')]"
					},
					"LS_ADLS_NYC_PAYROLL_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_NYC_PAYROLL_properties_typeProperties_url')]"
					},
					"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_server": {
						"value": "[parameters('LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_server')]"
					},
					"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_database": {
						"value": "[parameters('LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_database')]"
					},
					"LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZURE_SQL_NYC_PAYROLL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-nycpayroll-35985_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-nycpayroll-35985_ArmTemplate_0')]"
			]
		}
	]
}